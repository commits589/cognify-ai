# Copy this file to .env for local development (`npm run dev` / `netlify dev`).
# In production, set every one of these in Netlify: Site settings → Environment variables.
# Never commit a real .env file.

# ---------------------------------------------------------------------------
# Firebase web app config (from Firebase console → Project settings → General
# → Your apps → SDK setup and configuration). These are PUBLIC values — every
# Firebase web app ships them to the browser; that's normal and expected.
# Access control comes from firestore.rules / storage.rules, not from hiding
# these. Vite only exposes env vars prefixed with VITE_ to client code.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Server-only secrets — used exclusively inside netlify/functions/*.js and
# NEVER prefixed with VITE_, so Vite will not bundle them into the browser
# build. Set these in Netlify's dashboard for production; only put them in a
# local .env for `netlify dev` testing (and make sure .env is gitignored).
# ---------------------------------------------------------------------------

# Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Firebase Admin service account — Firebase console → Project settings →
# Service accounts → Generate new private key. That downloads a JSON file;
# copy the three fields below out of it (do NOT commit the JSON file itself).
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the private_key value from the JSON file, keeping the \n escape
# sequences literally as \n (don't turn them into real line breaks) — the
# function un-escapes them at runtime.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
